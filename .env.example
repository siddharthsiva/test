# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real API keys.

# https://api.purpleair.com/ (free signup, request a read key)
VITE_PURPLEAIR_API_KEY=

# https://docs.airnowapi.org/ (free signup)
VITE_AIRNOW_API_KEY=

# https://firms.modaps.eosdis.nasa.gov/api/map_key/ (free signup, MAP_KEY)
VITE_FIRMS_API_KEY=

# https://511.org/open-data/token (free signup, for road closure data)
VITE_511_API_KEY=

# Weather (Open-Meteo) needs no key — nothing to add here.

# https://console.firebase.google.com/ (create a project, then
# Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
